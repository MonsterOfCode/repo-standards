# fast checks only (well under a minute); the full test suite runs in pre-push.
# Secrets first: the staged changes, with the same rules as the CI secret scan (.gitleaks.toml).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so the staged changes cannot be scanned for secrets and the commit is refused." >&2
  echo "  Install it: brew install gitleaks   (other systems: https://github.com/gitleaks/gitleaks#installing)" >&2
  echo "  Then check: gitleaks version   - see docs/setup.md, Prerequisites." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml || exit 1
npm run checks --silent
